{
  "schemaVersion": 1,
  "id": "forwend-security-keys",
  "revision": 1,
  "kind": "architecture",
  "title": "Who can move money",
  "theme": "dark",
  "layoutHints": {
    "direction": "right",
    "pinnedNodeIds": []
  },
  "groups": [
    {
      "id": "outside",
      "label": "Outside Forwend",
      "parentId": null
    },
    {
      "id": "servers",
      "label": "Our servers",
      "parentId": null
    },
    {
      "id": "chain",
      "label": "On chain",
      "parentId": null
    }
  ],
  "nodes": [
    {
      "id": "creator",
      "kind": "actor",
      "label": "Freelancer or merchant",
      "groupId": "outside",
      "ports": []
    },
    {
      "id": "payer",
      "kind": "actor",
      "label": "Payer",
      "groupId": "outside",
      "ports": []
    },
    {
      "id": "privy",
      "kind": "external",
      "label": "Privy",
      "groupId": "outside",
      "ports": [],
      "description": "Login and users' wallets. Users sign their own sends; our server gets no send rights"
    },
    {
      "id": "userwallet",
      "kind": "external",
      "label": "User's Privy wallet",
      "groupId": "outside",
      "ports": [],
      "description": "Receives settlements. Only the user moves money out"
    },
    {
      "id": "token",
      "kind": "external",
      "label": "USDC / USDT contract",
      "groupId": "outside",
      "ports": [],
      "description": "The issuer can freeze any address or pause the token. Outside our control"
    },
    {
      "id": "api",
      "kind": "service",
      "label": "API",
      "groupId": "servers",
      "ports": [],
      "description": "No private keys. If hacked: can create bad invoices or show a wrong checkout; the signer re-checks the recipient"
    },
    {
      "id": "worker",
      "kind": "service",
      "label": "Worker (watcher)",
      "groupId": "servers",
      "ports": [],
      "description": "No keys. Reads the chain, keeps the ledger. If hacked: wrong states, no money moves"
    },
    {
      "id": "db",
      "kind": "datastore",
      "label": "Postgres",
      "groupId": "servers",
      "ports": [],
      "description": "Invoices, ledger, intents. If changed: the signer refuses terms that differ from Privy and the chain"
    },
    {
      "id": "signer",
      "kind": "service",
      "label": "Signer: executor key",
      "groupId": "servers",
      "ports": [],
      "description": "If leaked: can only deploy receivers and settle the exact amount to the fixed recipient before the window ends. Cannot steal"
    },
    {
      "id": "deployer",
      "kind": "service",
      "label": "Deployer key",
      "groupId": "servers",
      "ports": [],
      "description": "Used once per chain to deploy the factory. Holds nothing after"
    },
    {
      "id": "safe",
      "kind": "system",
      "label": "Safe multisig: refund authority",
      "groupId": "chain",
      "ports": [],
      "description": "Several owners must approve. Refunds held money, recovers wrong tokens, settles missed payments, pauses. One leaked owner key moves nothing"
    },
    {
      "id": "factory",
      "kind": "system",
      "label": "Factory v1",
      "groupId": "chain",
      "ports": [],
      "description": "No owner. Only the Safe can set its pause flag"
    },
    {
      "id": "receiver",
      "kind": "system",
      "label": "Invoice receiver (one per invoice)",
      "groupId": "chain",
      "ports": [],
      "description": "No key. Pays only the recipient; refunds and recovery only by the Safe"
    }
  ],

        "y": 12.25
      },
      "held": {
        "x": 1344,
        "y": 156.25
      },
      "refund_pending": {
        "x": 1738,
        "y": 164.75
      },
      "refunded": {
        "x": 2001,
        "y": 164.75
      }
    }
  }
}

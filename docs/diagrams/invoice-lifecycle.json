      },
      "settled": {
        "x": 1132,
        "y": 156
      },
      "expired": {
        "x": 754,
        "y": 315.5
      },
      "cancelled": {
        "x": 392,
        "y": 390
      },
      "expired_partial": {
        "x": 1166,
        "y": 12
      },
      "held": {
        "x": 1520,
        "y": 307.6
      },
      "refund_pending": {
        "x": 1914,
        "y": 312.26666666666665
      },
      "refunded": {
        "x": 2234,
        "y": 312.26666666666665
      }
    }
  }
}
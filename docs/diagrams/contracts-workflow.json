      "source": {
        "nodeId": "predict"
      },
      "target": {
        "nodeId": "checkout"
      },
      "type": "calls",
      "direction": "forward",
      "label": "receiver address"
    },
    {
      "id": "w5",
      "source": {
        "nodeId": "checkout"
      },
      "target": {
        "nodeId": "send"
      },
      "type": "calls",
      "direction": "forward"
    },
    {
      "id": "w6",
      "source": {
        "nodeId": "send"
      },
      "target": {
        "nodeId": "where"
      },
      "type": "calls",
      "direction": "forward"
    },
    {

{
  "schemaVersion": 1,
  "id": "forwend-contracts-workflow",
  "revision": 1,
  "kind": "workflow",
  "title": "Invoice receiver contracts: full workflow",
  "theme": "dark",
  "layoutHints": {
    "direction": "right",
    "pinnedNodeIds": []
  },
  "groups": [
    {
      "id": "creator",
      "label": "Freelancer or merchant",
      "parentId": null
    },
    {
      "id": "payer",
      "label": "Payer",
      "parentId": null
    },
    {
      "id": "backend",
      "label": "Backend (api + worker)",
      "parentId": null
    },
    {
      "id": "signer",
      "label": "Signer",
      "parentId": null
    },
    {
      "id": "chain",
      "label": "Contracts (factory + receiver)",
      "parentId": null
    },
    {
      "id": "admin",
      "label": "Platform admin",
      "parentId": null
    }
  ],
  "nodes": [
    {
      "id": "setup",
      "kind": "job",
      "label": "Deploy factory once per chain",
      "groupId": "chain",
      "ports": [],
      "description": "CREATE2 deployer gives one address on Base Sepolia, Arbitrum Sepolia, Arc testnet and Tempo testnet (C-03). Mainnet only after trials"
    },
    {
      "id": "create",
      "kind": "job",
      "label": "Create invoice",
      "groupId": "creator",
      "ports": [],
      "description": "Amount, token, network, expiry"
    },
    {
      "id": "terms",
      "kind": "job",
      "label": "Fix invoice terms",
      "groupId": "backend",
      "ports": [],
      "description": "invoiceId, recipient (profile wallet), token, amount, expiresAt, intendedChainId, refundAuthority, executor. Terms never change"
    },
    {
      "id": "predict",
      "kind": "job",
      "label": "Factory.predict(terms)",
      "groupId": "chain",
      "ports": [],
      "description": "View call, no gas. salt = keccak256(terms). Other terms give another address"
    },
    {
      "id": "checkout",
      "kind": "job",
      "label": "Show checkout",
      "groupId": "backend",
      "ports": [],
      "description": "Receiver address + QR, network and token warning. Nothing is deployed yet"
    },
    {
      "id": "send",
      "kind": "job",
      "label": "Send a plain USDC transfer",
      "groupId": "payer",
      "ports": [],
      "description": "From a wallet or an exchange withdrawal. No approve, no contract call"
    },
    {
      "id": "where",
      "kind": "decision",
      "label": "Right network and token?",
      "groupId": "payer",
      "ports": []
    },
    {
      "id": "detect",
      "kind": "job",
      "label": "Watcher sees Transfer log",
      "groupId": "backend",
      "ports": [],
      "description": "eth_getLogs for allowlisted tokens to active receiver addresses. State: detected, not final"
    },
    {
      "id": "intime",
      "kind": "decision",
      "label": "Block time before expiresAt?",
      "groupId": "backend",
      "ports": []
    },
    {
      "id": "total",
      "kind": "decision",
      "label": "Confirmed total reaches amount?",
      "groupId": "backend",
      "ports": [],
      "description": "Confirmed = safe block (Q-06)"
    },
    {
      "id": "partial",
      "kind": "job",
      "label": "Partially paid",
      "groupId": "backend",
      "ports": [],
      "description": "Show remaining amount and deadline"
    },
    {
      "id": "expiry",
      "kind": "job",
      "label": "expiresAt passes",
      "groupId": "backend",
      "ports": [],
      "description": "Expired partial stays in the receiver"
    },
    {
      "id": "final",
      "kind": "job",
      "label": "Wait for finalized block",
      "groupId": "backend",
      "ports": [],
      "description": "Then queue one settle intent"
    },
    {
      "id": "intent",
      "kind": "job",
      "label": "Settle intent",
      "groupId": "signer",
      "ports": [],
      "description": "Re-reads ledger and chain, checks terms match the address, caps amount"
    },
    {
      "id": "deployed",
      "kind": "decision",
      "label": "Receiver deployed?",
      "groupId": "signer",
      "ports": []
    },
    {
      "id": "deploy",
      "kind": "job",
      "label": "Factory.deploy(terms)",
      "groupId": "chain",
      "ports": [],
      "description": "Clone with immutable args at the predicted address. Lazy: only after a confirmed deposit. No initializer to front-run"
    },
    {
      "id": "settle",
      "kind": "job",
      "label": "Receiver.settle()",
      "groupId": "chain",
      "ports": [],
      "description": "Executor only. Sends min(balance, amount - settled) to the fixed recipient. Refuses if total never reached amount. Cannot pay twice"
    },
    {
      "id": "wallet",
      "kind": "job",
      "label": "Profile wallet gets the invoice amount",
      "groupId": "creator",
      "ports": [],
      "description": "State: settled"
    },
    {
      "id": "excess",
      "kind": "decision",
      "label": "Anything left in the receiver?",
      "groupId": "backend",
      "ports": []
    },
    {
      "id": "held",
      "kind": "job",
      "label": "Held for the payer",
      "groupId": "backend",
      "ports": [],
      "description": "Overpay excess, expired partial or late deposit. Never settled to the creator, never revenue"
    },
    {
      "id": "claim",
      "kind": "job",
      "label": "Start a refund claim",
      "groupId": "payer",
      "ports": [],
      "description": "Prove identity and destination. Never auto-refund to an exchange sender"
    },
    {
      "id": "approve",
      "kind": "decision",
      "label": "Approve claim?",
      "groupId": "admin",
      "ports": []
    },
    {
      "id": "refundsig",
      "kind": "job",
      "label": "Sign EIP-712 refund",
      "groupId": "signer",
      "ports": [],
      "description": "refundAuthority signs chain, receiver, invoice, token, amount, to, nonce, deadline"
    },
    {
      "id": "refund",
      "kind": "job",
      "label": "Receiver.refund(to, amount, sig)",
      "groupId": "chain",
      "ports": [],
      "description": "One refund per invoice, all held funds. Never touches settled money. Deploys the receiver first if needed"
    },
    {
      "id": "support",
      "kind": "job",
      "label": "Wrong-network or wrong-token case",
      "groupId": "admin",
      "ports": [],
      "description": "Payer reports the tx hash. Case-by-case review, recovery never promised"
    },
    {
      "id": "supported",
      "kind": "decision",
      "label": "Supported network?",
      "groupId": "admin",
      "ports": []
    },
    {
      "id": "recoversig",
      "kind": "job",
      "label": "Sign EIP-712 recover",
      "groupId": "signer",
      "ports": [],
      "description": "Same terms give the same address on that chain (C-03)"
    },
    {
      "id": "recover",
      "kind": "job",
      "label": "Receiver.recover(token, to, amount, sig)",
      "groupId": "chain",
      "ports": [],
      "description": "Deploy the receiver on that chain if needed, then return the funds"
    },
    {
      "id": "payerback",
      "kind": "job",
      "label": "Payer gets the funds back",
      "groupId": "payer",
      "ports": []
    },
    {
      "id": "lost",
      "kind": "job",
      "label": "No recovery possible",
      "groupId": "admin",
      "ports": [],
      "description": "Unsupported network: tell the payer plainly"
    },
    {
      "id": "done",
      "kind": "job",
      "label": "Invoice settled",
      "groupId": "creator",
      "ports": []
    }
  ],
  "edges": [
    {
      "id": "w1",
      "source": {
        "nodeId": "setup"
      },
      "target": {
        "nodeId": "predict"
      },
      "type": "calls",
      "direction": "forward",
      "label": "one-time setup"
    },
    {
      "id": "w2",
      "source": {
        "nodeId": "create"
      },
      "target": {
        "nodeId": "terms"
      },
      "type": "calls",
      "direction": "forward"
    },
    {
      "id": "w3",
      "source": {
        "nodeId": "terms"
      },
      "target": {
        "nodeId": "predict"
      },
      "type": "calls",
      "direction": "forward"
    },
    {

{
  "schemaVersion": 1,
  "id": "forwend-contracts-workflow",
  "revision": 9,
  "kind": "workflow",
  "title": "Invoice receiver contracts v1: full workflow",
  "theme": "dark",
  "layoutHints": {
    "direction": "right",
    "pinnedNodeIds": []
  },
  "groups": [
    {
      "id": "creator",
      "label": "Freelancer or merchant",
      "parentId": null
    },
    {
      "id": "payer",
      "label": "Payer",
      "parentId": null
    },
    {
      "id": "backend",
      "label": "Backend (api + worker)",
      "parentId": null
    },
    {
      "id": "signer",
      "label": "Signer (executor key)",
      "parentId": null
    },
    {
      "id": "chain",
      "label": "Contracts (factory + receiver)",
      "parentId": null
    },
    {
      "id": "admin",
      "label": "Platform admin + Safe multisig",
      "parentId": null
    }
  ],
  "nodes": [
    {
      "id": "setup",
      "kind": "job",
      "label": "Deploy factory v1 once per chain",
      "groupId": "chain",
      "ports": [],
      "description": "CREATE2 deployer (never nonce-based): same factory address and bytecode on Base Sepolia, Arbitrum Sepolia, Arc testnet, Tempo testnet. The factory holds the refund authority (Safe) and the executor; they are not in the terms"
    },
    {
      "id": "login",
      "kind": "job",
      "label": "Log in with Privy",
      "groupId": "creator",
      "ports": []
    },
    {
      "id": "create",
      "kind": "job",
      "label": "Create invoice",
      "groupId": "creator",
      "ports": [],
      "description": "Amount, token, network, expiry. Merchants: through the API, one invoice per order or per payment-link visit"
    },
    {
      "id": "auth",
      "kind": "job",
      "label": "Check session and profile",
      "groupId": "backend",
      "ports": [],
      "description": "Verify the Privy token; the user may act for this profile"
    },
    {
      "id": "valid",
      "kind": "decision",
      "label": "Request valid?",
      "groupId": "backend",
      "ports": [],
      "description": "Idempotency key, token on the allowlist, amount at least the minimum"
    },
    {
      "id": "reject",
      "kind": "job",
      "label": "Reject request",
      "groupId": "backend",
      "ports": []
    },
    {
      "id": "recipient",
      "kind": "job",
      "label": "Read recipient from profile wallet",
      "groupId": "backend",
      "ports": [],
      "description": "From the Privy wallet record, never from the request"
    },
    {
      "id": "terms",
      "kind": "job",
      "label": "Fix invoice terms",
      "groupId": "backend",
      "ports": [],
      "description": "invoiceId (256 random bits), recipient, token, amount, expiresAt (default 1 h, creator can change), settleDeadline, intendedChainId. Terms never change"
    },
    {
      "id": "predict",
      "kind": "job",
      "label": "Compute receiver address",
      "groupId": "chain",
      "ports": [],
      "description": "Locally, from the factory address and init-code hash compiled into the backend (same result as Factory.predict). Never from the database or an RPC"
    },
    {
      "id": "save",
      "kind": "job",
      "label": "Save invoice and watch address",
      "groupId": "backend",
      "ports": [],
      "description": "Terms, address, receive_method = evm_create2 (C-10). The watcher adds the address"
    },
    {
      "id": "checkout",
      "kind": "job",
      "label": "Show checkout",
      "groupId": "backend",
      "ports": [],
      "description": "The page recomputes the address from the terms and refuses a mismatch; no third-party scripts. Warnings: other networks can lose money; USDC.e is a different token. On Arc: an ERC-20 transfer, never a native send"
    },
    {
      "id": "cancel",
      "kind": "job",
      "label": "Cancel invoice (optional)",
      "groupId": "creator",
      "ports": [],
      "description": "Backend stops settling; anything sent later is held"
    },
    {
      "id": "send",
      "kind": "job",
      "label": "Send a plain USDC transfer",
      "groupId": "payer",
      "ports": [],
      "description": "From a wallet or an exchange withdrawal. No approve, no contract call"
    },
    {
      "id": "where",
      "kind": "decision",
      "label": "Right network and token?",
      "groupId": "backend",
      "ports": []
    },
    {
      "id": "detect",
      "kind": "job",
      "label": "Watcher sees Transfer log",
      "groupId": "backend",
      "ports": [],
      "description": "Only logs from the allowlisted token contract to a receive address we computed ourselves; logs from any other contract are ignored. Paid is decided from balanceOf (on Arc native USDC logs come from a system emitter). State: detected, not final"
    },
    {
      "id": "dust",
      "kind": "decision",
      "label": "At least the minimum?",
      "groupId": "backend",
      "ports": []
    },
    {
      "id": "intime",
      "kind": "decision",
      "label": "Block time before the close?",
      "groupId": "backend",
      "ports": []
    },
    {
      "id": "total",
      "kind": "decision",
      "label": "Confirmed total reaches amount?",
      "groupId": "backend",
      "ports": [],
      "description": "Confirmed = safe block (Q-06)"
    },
    {
      "id": "partial",
      "kind": "job",
      "label": "Partially paid",
      "groupId": "backend",
      "ports": [],
      "description": "Show remaining amount and deadline"
    },
    {
      "id": "expiry",
      "kind": "job",
      "label": "The close passes",
      "groupId": "backend",
      "ports": [],
      "description": "Expired partial stays in the receiver. The close is expiresAt, or the owner's one reopen (R-130)"
    },
    {
      "id": "final",
      "kind": "job",
      "label": "Wait for finalized block",
      "groupId": "backend",
      "ports": [],
      "description": "A second RPC confirms the balance; then queue one settle intent"
    },
    {
      "id": "intent",
      "kind": "job",
      "label": "Settle intent",
      "groupId": "signer",
      "ports": [],
      "description": "Re-reads ledger and chain, and the recipient from Privy. Refuses if anything differs from the terms"
    },
    {
      "id": "window",
      "kind": "decision",
      "label": "Before the effective deadline?",
      "groupId": "signer",
      "ports": []
    },
    {
      "id": "deployed",
      "kind": "decision",
      "label": "Receiver deployed?",
      "groupId": "signer",
      "ports": []
    },
    {
      "id": "deploy",
      "kind": "job",
      "label": "Factory.deploy(terms)",
      "groupId": "chain",
      "ports": [],
      "description": "Clone with immutable args at the predicted address, only by the executor or the Safe, after a confirmed deposit. Never rejects terms, so every address a payer saw stays deployable. Records deployedAt and receiverOf(invoiceId)"
    },
    {
      "id": "settle",
      "kind": "job",
      "label": "Receiver.settle()",
      "groupId": "chain",
      "ports": [],
      "description": "Intended chain only. Refuses unsafe terms (amount 0, bad recipient), so that money goes to refund. Exactly amount to the fixed recipient, once; checks the recipient received it. Executor until min(settleDeadline, deployedAt + 30 days), then only the multisig. Reverts unless the factory deployed this receiver (deployedAt), so clones made outside the factory do nothing"
    },
    {
      "id": "wallet",
      "kind": "job",
      "label": "Profile wallet gets the invoice amount",
      "groupId": "creator",
      "ports": [],
      "description": "State: settled"
    },
    {
      "id": "excess",
      "kind": "decision",
      "label": "Anything left in the receiver?",
      "groupId": "backend",
      "ports": []
    },
    {
      "id": "done",
      "kind": "job",
      "label": "Invoice settled",
      "groupId": "creator",
      "ports": []
    },
    {
      "id": "missed",
      "kind": "decision",
      "label": "Paid on time? (our outage)",
      "groupId": "admin",
      "ports": [],
      "description": "Settlement missed settleDeadline"
    },
    {
      "id": "pause",
      "kind": "job",
      "label": "Pause switch",
      "groupId": "admin",
      "ports": [],
      "description": "Multisig sets the factory pause: settle stops, refunds still work. Used when a bug is found"
    },
    {
      "id": "held",
      "kind": "job",
      "label": "Held for the payer",
      "groupId": "backend",
      "ports": [],
      "description": "Overpay excess, expired partial, late deposit, dust, or money after cancel. Settled to the creator only after the owner's reopen (R-130), up to the amount"
    },
    {
      "id": "claim",
      "kind": "job",
      "label": "Start a refund claim",
      "groupId": "payer",
      "ports": [],
      "description": "Prove identity and destination. Never auto-refund to an exchange sender"
    },
    {
      "id": "approve",
      "kind": "decision",
      "label": "Approve claim?",
      "groupId": "admin",
      "ports": []
    },
    {
      "id": "saferefund",
      "kind": "job",
      "label": "Multisig approves refund",
      "groupId": "admin",
      "ports": [],
      "description": "A proposed Safe transaction; owners check the hash with an independent tool; 24-48 h delay. One refund per approved claim (D-08), to the sender by default"
    },
    {
      "id": "refund",
      "kind": "job",
      "label": "Receiver.refund(to, amount)",
      "groupId": "chain",
      "ports": [],
      "description": "Refund authority only, intended chain only. May repeat; never more than the refundable amount, never the amount owed before settleDeadline. If not deployed yet, the queued Safe transaction calls Factory.deploy first (MultiSendCallOnly)"
    },
    {
      "id": "payerback",
      "kind": "job",
      "label": "Payer gets the money back",
      "groupId": "payer",
      "ports": []
    },
    {
      "id": "support",
      "kind": "job",
      "label": "Wrong-network or wrong-token case",
      "groupId": "admin",
      "ports": [],
      "description": "Payer reports the tx hash. Includes USDC.e and native coins"
    },
    {
      "id": "supported",
      "kind": "decision",
      "label": "Our factory on that chain?",
      "groupId": "admin",
      "ports": []
    },
    {
      "id": "review",
      "kind": "decision",
      "label": "Approve recovery?",
      "groupId": "admin",
      "ports": [],
      "description": "Case by case, never promised"
    },
    {
      "id": "saferecover",
      "kind": "job",
      "label": "Multisig approves recover",
      "groupId": "admin",
      "ports": [],
      "description": "Same Safe rules: independent hash check, 24-48 h delay"
    },
    {
      "id": "recover",
      "kind": "job",
      "label": "recover(token, to, amount)",
      "groupId": "chain",
      "ports": [],
      "description": "Any non-invoice token, the native coin, or a wrong chain. On the intended chain it never lowers the invoice-token balance (Arc: native coin = USDC). If not deployed on that chain, the queued Safe transaction calls Factory.deploy first (MultiSendCallOnly). On a receiver, the factory or the implementation: money sent to the factory or the implementation leaves only from their own balance, never a receiver's"
    },
    {
      "id": "lost",
      "kind": "job",
      "label": "No recovery",
      "groupId": "admin",
      "ports": [],
      "description": "Unsupported network or rejected case. The payer was warned at checkout"
    }
  ],

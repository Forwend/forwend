        "nodeId": "detect"
      },
      "type": "outcome",
      "direction": "forward",
      "outcome": "yes"
    },
    {
      "id": "w8",
      "source": {
        "nodeId": "where"
      },
      "target": {
        "nodeId": "support"
      },
      "type": "outcome",
      "direction": "forward",
      "outcome": "no"
    },
    {
      "id": "w9",
      "source": {
        "nodeId": "detect"
      },
      "target": {
        "nodeId": "intime"
      },
      "type": "calls",
      "direction": "forward"
    },
    {
      "id": "w10",
      "source": {
        "nodeId": "intime"
      },
      "target": {
        "nodeId": "total"
      },
      "type": "outcome",
      "direction": "forward",
      "outcome": "yes"
    },
    {
      "id": "w11",
      "source": {
        "nodeId": "intime"
      },
      "target": {
        "nodeId": "held"
      },
      "type": "outcome",
      "direction": "forward",
      "outcome": "no: late deposit"
    },
    {
      "id": "w12",
      "source": {
        "nodeId": "total"
      },
      "target": {
        "nodeId": "final"
      },
      "type": "outcome",
      "direction": "forward",
      "outcome": "yes: paid"
    },
    {
      "id": "w13",

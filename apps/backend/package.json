{
  "name": "@forwend/backend",
  "private": true,
  "scripts": {
    "build": "go build ./...",
    "test": "sh -c 'f=$(gofmt -l .); [ -z \"$f\" ] || { echo \"gofmt: $f\"; exit 1; }' && go vet -tags e2e,privylive ./... && sh scripts/with-env.sh go test -race -count=1 ./...",
    "postgres:up": "docker compose --env-file .env -f ../../infra/docker-compose.yml up -d --wait",
    "api": "sh scripts/with-env.sh go run ./cmd/api",
    "worker": "sh scripts/with-env.sh go run ./cmd/worker",
    "signer": "sh scripts/with-env.sh go run ./cmd/signer",
    "e2e": "sh scripts/with-env.sh go test -tags e2e -count=1 -v ./e2e/"
  }
}

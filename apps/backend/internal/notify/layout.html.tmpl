<!DOCTYPE html>
<html lang="en" xmlns="http://www.w3.org/1999/xhtml">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="x-apple-disable-message-reformatting">
<meta name="color-scheme" content="light dark">
<meta name="supported-color-schemes" content="light dark">
<title>{{.Subject}}</title>
<style>
  body { margin: 0; padding: 0; }
  a { color: #0e0f0e; }
  @media (max-width: 620px) {
    .fw-pad { padding-left: 20px !important; padding-right: 20px !important; }
    .fw-title { font-size: 22px !important; }
    .fw-amount { font-size: 30px !important; }
    .fw-term { white-space: normal !important; }
  }
  @media (prefers-color-scheme: dark) {
    .fw-bg { background-color: #0c0d0c !important; }
    .fw-card { background-color: #141615 !important; border-color: #262826 !important; }
    .fw-ink { color: #eeefec !important; }
    .fw-muted { color: #a7aaa5 !important; }
    .fw-line { border-color: #262826 !important; }
    .fw-link { color: #eeefec !important; }
    .fw-note { background-color: #1c1e1d !important; border-color: #262826 !important; }
    .fw-badge-success { background-color: #10261b !important; color: #4cc08a !important; }
    .fw-badge-warning { background-color: #2a2111 !important; color: #e9b863 !important; }
    .fw-badge-neutral { background-color: #1c1e1d !important; color: #a7aaa5 !important; }
  }
  /* The Outlook app recolors on its own; these keep its dark mode readable. */
  [data-ogsc] .fw-ink, [data-ogsc] .fw-link { color: #eeefec !important; }
  [data-ogsc] .fw-muted { color: #a7aaa5 !important; }
</style>
</head>
<body class="fw-bg" style="margin:0;padding:0;background-color:#f6f7f5;">
<div style="display:none;max-height:0;overflow:hidden;opacity:0;mso-hide:all;">{{.Preheader}}&#8199;&#65279;&#847;&#8199;&#65279;&#847;&#8199;&#65279;&#847;&#8199;&#65279;&#847;&#8199;&#65279;&#847;&#8199;&#65279;&#847;</div>
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" class="fw-bg" style="background-color:#f6f7f5;">
<tr><td align="center" style="padding:32px 12px;">
  <table role="presentation" width="600" cellpadding="0" cellspacing="0" border="0" style="width:100%;max-width:600px;">
    <tr><td class="fw-pad" style="padding:0 32px 20px 32px;">
      <a href="{{.Site}}" style="text-decoration:none;">
        <img src="{{.Logo}}" width="28" height="28" alt="" style="display:inline-block;vertical-align:middle;border:0;border-radius:6px;">
        <span class="fw-ink" style="display:inline-block;vertical-align:middle;margin-left:8px;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:17px;font-weight:600;letter-spacing:-0.01em;color:#0e0f0e;">Forwend</span>
      </a>
    </td></tr>
    <tr><td class="fw-card" style="background-color:#ffffff;border:1px solid #e8e9e6;border-radius:16px;">
      <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">
        <tr><td class="fw-pad" style="padding:32px 40px 8px 40px;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;">
          {{with .Badge}}<span class="fw-badge-{{$.Tone}}" style="display:inline-block;padding:2px 10px;border-radius:6px;font-size:13px;font-weight:600;line-height:20px;{{if eq $.Tone "success"}}background-color:#e7f3ec;color:#16744a;{{else if eq $.Tone "warning"}}background-color:#fbf1df;color:#8f4d00;{{else}}background-color:#f6f7f5;color:#5b5e5a;{{end}}">{{.}}</span>{{end}}
          <h1 class="fw-title fw-ink" style="overflow-wrap:anywhere;word-break:break-word;margin:{{if .Badge}}16px{{else}}0{{end}} 0 0 0;font-size:26px;font-weight:600;line-height:1.25;letter-spacing:-0.02em;color:#0e0f0e;">{{keep .Title}}</h1>
          {{with .Amount}}<p class="fw-amount fw-ink" style="margin:12px 0 0 0;font-size:36px;font-weight:500;line-height:1.15;letter-spacing:-0.03em;font-variant-numeric:tabular-nums;color:#0e0f0e;">{{.}}</p>{{end}}
          {{range .Lead}}<p class="fw-muted" style="overflow-wrap:anywhere;word-break:break-word;margin:16px 0 0 0;font-size:16px;line-height:1.6;color:#5b5e5a;">{{keep .}}</p>{{end}}
        </td></tr>
        {{if .Details}}<tr><td class="fw-pad" style="padding:20px 40px 0 40px;">
          <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:14px;line-height:1.5;">
            {{range .Details}}<tr>
              <td class="fw-muted fw-line fw-term" style="padding:12px 16px 12px 0;border-top:1px solid #e8e9e6;color:#5b5e5a;white-space:nowrap;vertical-align:top;">{{.Label}}</td>
              <td class="fw-ink fw-line" align="right" style="padding:12px 0;border-top:1px solid #e8e9e6;color:#0e0f0e;text-align:right;word-break:break-word;font-variant-numeric:tabular-nums;">{{if .Href}}<a class="fw-link" href="{{.Href}}" style="color:#0e0f0e;text-decoration:underline;">{{.Value}}</a>{{else}}{{.Value}}{{end}}</td>
            </tr>{{end}}
          </table>
        </td></tr>{{end}}
        {{with .Note}}<tr><td class="fw-pad" style="padding:20px 40px 0 40px;">
          <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0"><tr>
            <td class="fw-note fw-muted" style="overflow-wrap:anywhere;word-break:break-word;padding:14px 16px;background-color:#f6f7f5;border:1px solid #e8e9e6;border-radius:10px;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:14px;line-height:1.5;color:#5b5e5a;">{{.}}</td>
          </tr></table>
        </td></tr>{{end}}
        <tr><td class="fw-pad" style="padding:28px 40px 36px 40px;">
          <a href="{{.Button.URL}}" style="display:inline-block;padding:13px 22px;border:1px solid #a9cf3c;border-radius:10px;background-color:#c9ef5f;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:15px;font-weight:600;line-height:20px;color:#0e0f0e;text-decoration:none;">{{.Button.Label}}</a>
        </td></tr>
      </table>
    </td></tr>
    <tr><td class="fw-pad fw-muted" style="padding:24px 32px 0 32px;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:12px;line-height:1.6;color:#5b5e5a;">
      <p style="margin:0 0 8px 0;">{{.Reason}}{{with .Settings}} <a class="fw-link" href="{{.}}" style="color:#5b5e5a;text-decoration:underline;">Email settings</a>{{end}}{{with .Stop}} <a class="fw-link" href="{{.}}" style="color:#5b5e5a;text-decoration:underline;">Stop reminders</a>{{end}}</p>
      {{with .Support}}<p style="margin:0 0 8px 0;">Questions? <a class="fw-link" href="mailto:{{.}}" style="color:#5b5e5a;text-decoration:underline;">{{.}}</a></p>{{end}}
      <p style="margin:0;">Forwend{{with .Postal}} · {{.}}{{end}}</p>
    </td></tr>
  </table>
</td></tr>
</table>
</body>
</html>

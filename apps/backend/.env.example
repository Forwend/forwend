# Copy to apps/backend/.env (git-ignored). Local development values only.
POSTGRES_USER=forwend
POSTGRES_PASSWORD=forwend
POSTGRES_DB=forwend
POSTGRES_PORT=55432
DATABASE_URL=postgres://forwend:forwend@localhost:55432/forwend?sslmode=disable
API_ADDR=:8080
# Privy dashboard > App settings. The api loads the token signing keys from the JWKS URL at startup, and uses the app
# secret to make profile wallets. Never log the secret.
PRIVY_APP_ID=
PRIVY_JWKS_URL=https://auth.privy.io/api/v1/apps/<PRIVY_APP_ID>/jwks.json
PRIVY_APP_SECRET=
# api, worker and signer: the shared chain list, Infura keys (comma-separated, tried before public RPCs; any placeholder
# such as "none" when only local chains run), and for worker and signer the time between rounds. A chain needs two
# working RPC hosts (D-15).
CHAINS_FILE=../../packages/contracts/chains.json
INFURA_API_KEYS=
POLL_INTERVAL=5s
# api only: the web app's origin. Invoice and receipt PDFs link to its /pay/<invoiceId> page.
PUBLIC_WEB_URL=http://localhost:3000
# signer only: the factory executor's key (the deployer key in packages/contracts/.env on testnets), funded for gas.
# Root `pnpm dev` starts the signer only when this is set; without it paid invoices stay on their way. Never log it.
EXECUTOR_PRIVATE_KEY=

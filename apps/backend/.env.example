# Copy to apps/backend/.env (git-ignored). Local development values only.
POSTGRES_USER=forwend
POSTGRES_PASSWORD=forwend
POSTGRES_DB=forwend
POSTGRES_PORT=55432
# pool_max_conns: keep the api replicas' sum plus the worker's and signer's (each one more, for its lock) under
# Postgres max_connections. Quoted: the shell would read & as a command.
DATABASE_URL='postgres://forwend:forwend@localhost:55432/forwend?sslmode=disable&pool_max_conns=20'
API_ADDR=:8080
# Dokploy defaults to 1: enable Base Sepolia, Arbitrum Sepolia and Arc Testnet USDC, plus Tempo OUSD, at each API start.
# 0 leaves the database's network configuration unchanged.
ENABLE_TESTNET_USDC=0
# Live chains the API switches on at each start, by chain ID: 8453 Base, 42161 Arbitrum, 5042 Arc, 4217 Tempo (R-222).
# Each needs the factory deployed and executor gas. Empty leaves them as the database has them.
ENABLE_MAINNETS=
# The platform fee on new invoices (D-122): basis points of the price, 0 to 500, within a USD minimum and cap.
# Unset: 0, no platform fee. The api and the worker read the same values.
PLATFORM_FEE_BPS=
PLATFORM_FEE_MIN_USD=
PLATFORM_FEE_CAP_USD=
# Privy dashboard > App settings. Never log the secret.
PRIVY_APP_ID=
PRIVY_JWKS_URL=https://auth.privy.io/api/v1/apps/<PRIVY_APP_ID>/jwks.json
PRIVY_APP_SECRET=
# RPC endpoints are configured in Postgres; private endpoints reference this server-only secret map.
# RPC_RATE_PER_SECOND: local endpoint pacing and shared weighted budget (rate * 80 units/second).
# See docs/backend/architecture.md#running-the-loop for method weights and provider buckets.
# Each enabled chain needs one working RPC endpoint; additional endpoints provide failover (D-15).
RPC_ENDPOINT_SECRETS=
# Local Anvil only; keep 0 in production.
RPC_ALLOW_LOOPBACK=0
RPC_RATE_PER_SECOND=10
# api: each signed-in user's burst of requests; leave it unset (60). Only the live e2e sets it.
API_USER_BURST=
# api: each user's Confirm it's you codes an hour; leave it unset (10). Only the live e2e sets it.
API_CODES_PER_HOUR=
# 1 when a proxy in front sets X-Forwarded-For to the client's address (Traefik on staging): public Pay is then limited
# per payer. Locally there is none, so leave it empty.
TRUST_PROXY_HEADER=
POLL_INTERVAL=5s
# api and worker: the web app's origin, for the links in PDFs and emails.
PUBLIC_WEB_URL=http://localhost:3000
# api and webhooks (R-146, R-148): 32 random bytes in base64 that seal webhook signing secrets, such as
# `openssl rand -base64 32`.
# Empty leaves webhooks off. Never log it, and keep it: a new key can't open the secrets the old one sealed.
WEBHOOK_SECRET_KEY=
# worker and api (R-80, D-65, R-137): a send-only Resend API key. The worker sends the outbox; the api sends
# Confirm it's you codes at once. Empty: no email is sent, the events wait, and only a full sign-in is fresh. Never log it.
# RESEND_API_URL is only for tests with a fake Resend; an empty EMAIL_POSTAL_ADDRESS leaves the footer address out.
# SUPPORT_EMAIL is the support inbox each footer names; empty leaves that line out.
RESEND_API_KEY=
EMAIL_FROM=
EMAIL_POSTAL_ADDRESS=
SUPPORT_EMAIL=
# signer only: the factory executor's key (the deployer key in packages/contracts/.env on testnets). The signer starts
# only when it holds gas for a deploy and a settle on every enabled chain. Root `pnpm dev` needs it. Never log it.
EXECUTOR_PRIVATE_KEY=
# canary only (R-51), on its own host; its page script needs Playwright's Chromium. CODE_HASH is keccak256 of the
# deployed code. An RPC URL may hold a key: never log it. Quoted: the shell would split the JSON.
CANARY_API_URL=http://localhost:8080
CANARY_WEB_URL=http://localhost:3000
CANARY_FACTORY=0xe917cE63865f8Cf91a0038136E496B25eCE2A54e
CANARY_FACTORY_CODE_HASH=0x96754fe3bd2426daf27ada13d5c1ea7d8ae125bec60698ec3198426e17c86975
# 1 when that factory's terms carry the fees (v2 on, R-226); 0 for v1.1.
CANARY_FACTORY_FEES=1
CANARY_RPC_URLS='{"84532": ["https://sepolia.base.org", "https://base-sepolia-rpc.publicnode.com"], "421614": ["https://sepolia-rollup.arbitrum.io/rpc", "https://arbitrum-sepolia-rpc.publicnode.com"], "5042002": ["https://rpc.blockdaemon.testnet.arc.io", "https://arc-testnet-rpc.publicnode.com"], "42431": ["https://rpc.moderato.tempo.xyz", "https://rpc.testnet.tempo.xyz"]}'
CANARY_PAGE_SCRIPT=../web/scripts/canary-pay-page.ts
# The canary's own copies of 1Click's root and quote key (R-235); empty uses 1Click's. Only tests set them.
CANARY_ONECLICK_URL=
CANARY_ONECLICK_KEY=

# The ECB's euro reference rates for records in another currency (R-110). ECB_RATES_URL is for tests that run a
# fake ECB only; empty reads the ECB's own file.
ECB_RATES_URL=

# worker only (R-178): CoinGecko's USD prices of the stablecoins, for display. COINGECKO_API_KEY is an optional Demo
# plan key; empty calls without one. Never log it.
# COINGECKO_INTERVAL: time between reads, at least 1m; empty is 15m. COINGECKO_API_URL is for tests with a fake only.
COINGECKO_API_KEY=
COINGECKO_INTERVAL=
COINGECKO_API_URL=

# api and worker (D-123): NEAR Intents 1Click, for payers paying from other chains. ONECLICK_API_KEY is the optional
# partner key (Q-18); without it each conversion costs the payer 0.25% more. Never log it.
# ONECLICK_API_URL and ONECLICK_SIGNER_KEY are for tests with a fake only; empty uses 1Click and its own quote key.
# Startup refuses ONECLICK_SIGNER_KEY unless ONECLICK_API_URL is on loopback.
ONECLICK_API_KEY=
ONECLICK_API_URL=
ONECLICK_SIGNER_KEY=

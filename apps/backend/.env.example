# Copy to apps/backend/.env (git-ignored). Local development values only.
POSTGRES_USER=forwend
POSTGRES_PASSWORD=forwend
POSTGRES_DB=forwend
POSTGRES_PORT=55432
# pool_max_conns: the most Postgres connections each process opens (pgxpool; left out: the larger of 4 and the CPU
# count). In production keep the api replicas' sum plus the worker's and signer's (each one more, for its lock) under
# Postgres max_connections (100 by default). Quoted: the shell would read & as a command.
DATABASE_URL='postgres://forwend:forwend@localhost:55432/forwend?sslmode=disable&pool_max_conns=20'
API_ADDR=:8080
# Privy dashboard > App settings. The api loads the token signing keys from the JWKS URL at startup, and uses the app
# secret to make profile wallets. Never log the secret.
PRIVY_APP_ID=
PRIVY_JWKS_URL=https://auth.privy.io/api/v1/apps/<PRIVY_APP_ID>/jwks.json
PRIVY_APP_SECRET=
# api, worker and signer: the shared chain list, Infura keys (comma-separated, used before public RPCs; empty: public
# RPCs only), the most calls per second each process sends to one RPC endpoint (an Infura key or a public URL; a batch
# counts each call), and for worker and signer the time between rounds. A chain needs two RPC hosts (D-15): without
# Infura keys only Arc Testnet has them.
CHAINS_FILE=../../packages/contracts/chains.json
INFURA_API_KEYS=
RPC_RATE_PER_SECOND=10
# api: each signed-in user's burst of requests; leave it unset (60). Only the live e2e sets it.
API_USER_BURST=
POLL_INTERVAL=5s
# api and worker: the web app's origin. Invoice and receipt PDFs link to its /pay/<payToken> page; the worker's emails
# link to /app/invoices/<invoiceId>.
PUBLIC_WEB_URL=http://localhost:3000
# worker only (R-80, D-65): a send-only Resend API key for the verified sending domain. Empty: no email is sent and the
# events wait. EMAIL_FROM defaults to "Forwend <notifications@mail.forwend.com>". RESEND_API_URL is for tests that
# run a fake Resend only. EMAIL_POSTAL_ADDRESS is the sender's address in each email's footer; empty leaves it out.
# Never log the key.
RESEND_API_KEY=
EMAIL_FROM=
EMAIL_POSTAL_ADDRESS=
# signer only: the factory executor's key (the deployer key in packages/contracts/.env on testnets). The signer starts
# only when it holds gas for a deploy and a settle on every enabled chain. Root `pnpm dev` needs it. Never log it.
EXECUTOR_PRIVATE_KEY=
# canary only (R-51), on its own host: the public api and web origins it checks; its own factory, factory code hash
# (keccak256 of the deployed code, the same on every chain) and two RPCs on different hosts per chain ID; and the
# browser script it runs with node (Playwright's Chromium installed). An RPC URL may hold a key: never log it. Quoted:
# the shell would split the JSON.
CANARY_API_URL=http://localhost:8080
CANARY_WEB_URL=http://localhost:3000
CANARY_FACTORY=0xECe745390524e4d0B05D26F56AF7F1D38FDb7546
CANARY_FACTORY_CODE_HASH=0xd39b875b482a1866c4d526344b3f2211b5093a0ec2075549156f3990c1d5e3ee
CANARY_RPC_URLS='{"84532": ["https://sepolia.base.org", "https://base-sepolia-rpc.publicnode.com"], "421614": ["https://sepolia-rollup.arbitrum.io/rpc", "https://arbitrum-sepolia-rpc.publicnode.com"], "5042002": ["https://rpc.drpc.testnet.arc.io", "https://rpc.quicknode.testnet.arc.io"], "42431": ["https://rpc.moderato.tempo.xyz", "https://tempo-moderato-testnet.drpc.org"]}'
CANARY_PAGE_SCRIPT=../web/scripts/canary-pay-page.ts

# The ECB's euro reference rates for records in another currency (R-110). ECB_RATES_URL is for tests that run a
# fake ECB only; empty reads the ECB's own file.
ECB_RATES_URL=

# Copy to apps/backend/.env (git-ignored). Local development values only.
POSTGRES_USER=forwend
POSTGRES_PASSWORD=forwend
POSTGRES_DB=forwend
POSTGRES_PORT=55432
DATABASE_URL=postgres://forwend:forwend@localhost:55432/forwend?sslmode=disable
API_ADDR=:8080
# Privy dashboard > App settings. The api loads the token signing keys from the JWKS URL at startup.
PRIVY_APP_ID=
PRIVY_JWKS_URL=https://auth.privy.io/api/v1/apps/<PRIVY_APP_ID>/jwks.json
# worker and signer: the shared chain list, Infura keys (comma-separated, tried before public RPCs; any placeholder
# such as "none" when only local chains run), time between rounds. A chain needs two working RPC hosts (D-15).
CHAINS_FILE=../../packages/contracts/chains.json
INFURA_API_KEYS=
POLL_INTERVAL=5s
# signer only: the factory executor's key (the deployer key in packages/contracts/.env on testnets). Never log it.
EXECUTOR_PRIVATE_KEY=

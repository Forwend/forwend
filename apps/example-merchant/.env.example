# Copy to .env (git-ignored). The shop's server reads these; none of them reaches the browser.
# Forwend's API, such as https://forwend.com/api, or http://localhost:8080 for a local backend.
FORWEND_API_URL=
# A secret key from the Developers page of a merchant profile, with invoices.read and invoices.write.
FORWEND_API_KEY=
# The profile ID and the store ID, both on the Developers page.
FORWEND_PROFILE_ID=
FORWEND_STORE_ID=
# The signing secret (whsec_...) of a webhook endpoint pointing at /api/webhooks/forwend.
FORWEND_WEBHOOK_SECRET=
# Forwend's web app, where the checkout lives: https://forwend.com, or http://localhost:3000 locally.
# Add this shop's own origin, such as http://localhost:3100, to the store's allowed origins.
FORWEND_URL=
# Where the shop keeps its orders.
EXAMPLE_DATABASE=example-merchant.db

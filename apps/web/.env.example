# Copy to apps/web/.env (git-ignored). Next.js and the Privy Playwright test read it.
# Privy dashboard > App settings: the app ID (public; shipped to browsers).
NEXT_PUBLIC_PRIVY_APP_ID=
# The support inbox payers see in the pay page's Need help. Read by `next build`; empty hides its Email support action.
NEXT_PUBLIC_SUPPORT_EMAIL=
# The backend api the app's /api/v1 requests are forwarded to. Read by `next build` (the rewrite is fixed then).
API_URL=http://localhost:8080
# Privy dashboard > User management > Test accounts: the test email and its fixed code. Only the sign-in e2e test
# uses them; it is skipped when they are empty.
PRIVY_TEST_EMAIL=
PRIVY_TEST_OTP=

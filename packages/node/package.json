{
  "name": "forwend",
  "version": "0.2.1",
  "description": "The Forwend API for Node: checkout sessions, payments, invoices, stores, webhook events and webhook verification.",
  "license": "MIT",
  "homepage": "https://forwend.com/docs",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Forwend/forwend.git",
    "directory": "packages/node"
  },
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepublishOnly": "pnpm run build",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "vitest": "5.0.5"
  }
}

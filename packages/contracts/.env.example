# Copy to packages/contracts/.env (git-ignored). Read by script/deploy.sh and script/rpc.mjs.
# The deployer signs every deploy; the refund authority stands in for the Safe. The development mainnet factory (F437)
# uses these same keys, so they guard real money there: keep them off shared machines.
DEPLOYER_PRIVATE_KEY=
REFUND_AUTHORITY_PRIVATE_KEY=
# Address of the factory's first executor (deployments.json): part of the factory address, kept after setExecutor.
FIRST_EXECUTOR=
# Comma-separated Infura keys; rpc.mjs tries each, then public RPCs.
INFURA_API_KEYS=

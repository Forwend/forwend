# Copy to packages/contracts/.env (git-ignored). Read by script/deploy.sh and script/rpc.mjs. Testnet keys only.
# The deployer signs every testnet transaction; the refund authority stands in for the Safe on testnets.
DEPLOYER_PRIVATE_KEY=
REFUND_AUTHORITY_PRIVATE_KEY=
# Address of the factory's first executor (deployments.json): part of the factory address, kept after setExecutor.
FIRST_EXECUTOR=
# Comma-separated Infura keys; rpc.mjs tries each, then public RPCs.
INFURA_API_KEYS=

{
  "name": "@forwend/js",
  "version": "0.1.1",
  "description": "Forwend checkout in the browser: a pay link, and the embedded checkout framed in your page.",
  "license": "MIT",
  "homepage": "https://forwend.com/docs",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Forwend/forwend.git",
    "directory": "packages/js"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "devDependencies": {
    "jsdom": "30.1.3",
    "vitest": "5.0.5"
  }
}

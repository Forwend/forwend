{
  "name": "@forwend/react",
  "version": "0.1.1",
  "description": "Forwend checkout for React 18 and 19: PayButton, Checkout and PaymentElement.",
  "license": "MIT",
  "homepage": "https://forwend.com/docs",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Forwend/forwend.git",

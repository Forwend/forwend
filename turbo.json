{
  "$schema": "https://turborepo.com/schema.json",
  "agentGuidance": false,
  "globalDependencies": ["tsconfig.base.json"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "env": ["API_URL", "NEXT_PUBLIC_PRIVY_APP_ID", "NEXT_PUBLIC_SUPPORT_EMAIL"],
      "outputs": [".next/**", "!.next/cache/**", "!.next/dev/**", "out/**", "dist/**"]
    },
    "typecheck": {
      "dependsOn": ["^typecheck"]
    },
    "test": {
      "passThroughEnv": ["DATABASE_URL", "BASE_SEPOLIA_RPC"],
      "cache": false
    },
    "e2e": {
      "cache": false,
      "passThroughEnv": ["CI", "DATABASE_URL"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
